{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Agent",
      "Skill",
      "SendMessage",
      "mcp__hearthbot__*",
      "mcp__claude-code-remote__*",
      "Edit(/worktrees/**)",
      "Write(/worktrees/**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(jq *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(mkdir -p *)",
      "Bash(test *)",
      "Bash(.claude/skills/*)",
      "Bash(./.claude/skills/*)",
      "Bash(python3 .claude/skills/*)",
      "Bash(python3 ./.claude/skills/*)",
      "Bash(./ops check*)",
      "Bash(./ops status*)",
      "Bash(./ops sync*)",
      "Bash(yarn install)",
      "Bash(yarn install *)",
      "Bash(yarn build)",
      "Bash(yarn build *)",
      "Bash(yarn lint)",
      "Bash(yarn lint *)",
      "Bash(yarn typecheck)",
      "Bash(yarn typecheck *)",
      "Bash(yarn test)",
      "Bash(yarn test *)",
      "Bash(yarn format:check)",
      "Bash(yarn format:check *)",
      "Bash(node .yarn/releases/yarn-*.cjs install)",
      "Bash(node .yarn/releases/yarn-*.cjs install *)",
      "Bash(node .yarn/releases/yarn-*.cjs build)",
      "Bash(node .yarn/releases/yarn-*.cjs build *)",
      "Bash(node .yarn/releases/yarn-*.cjs lint)",
      "Bash(node .yarn/releases/yarn-*.cjs lint *)",
      "Bash(node .yarn/releases/yarn-*.cjs typecheck)",
      "Bash(node .yarn/releases/yarn-*.cjs typecheck *)",
      "Bash(node .yarn/releases/yarn-*.cjs test)",
      "Bash(node .yarn/releases/yarn-*.cjs test *)",
      "Bash(node .yarn/releases/yarn-*.cjs format:check)",
      "Bash(node .yarn/releases/yarn-*.cjs format:check *)",
      "Bash(node ../.yarn/releases/yarn-*.cjs install)",
      "Bash(node ../.yarn/releases/yarn-*.cjs install *)",
      "Bash(node ../.yarn/releases/yarn-*.cjs build)",
      "Bash(node ../.yarn/releases/yarn-*.cjs build *)",
      "Bash(node ../.yarn/releases/yarn-*.cjs lint)",
      "Bash(node ../.yarn/releases/yarn-*.cjs lint *)",
      "Bash(node ../.yarn/releases/yarn-*.cjs typecheck)",
      "Bash(node ../.yarn/releases/yarn-*.cjs typecheck *)",
      "Bash(node ../.yarn/releases/yarn-*.cjs test)",
      "Bash(node ../.yarn/releases/yarn-*.cjs test *)",
      "Bash(node ../.yarn/releases/yarn-*.cjs format:check)",
      "Bash(node ../.yarn/releases/yarn-*.cjs format:check *)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs install)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs install *)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs build)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs build *)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs lint)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs lint *)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs typecheck)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs typecheck *)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs test)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs test *)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs format:check)",
      "Bash(node ../../.yarn/releases/yarn-*.cjs format:check *)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run check*)",
      "Bash(npm install*)",
      "Bash(npm test*)",
      "Bash(node --test*)",
      "Bash(npx tsc)",
      "Bash(npx tsc *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose -p * ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose -p * logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose -p * up*)",
      "Bash(docker compose build*)",
      "Bash(docker compose -p * build*)",
      "Bash(docker compose down*)",
      "Bash(docker compose -p * down*)",
      "Bash(docker ps*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "deny": [
      "Edit(/packages/**)",
      "Read(**/node_modules/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.cer)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(*wt rm *--force*)",
      "Bash(*skills/wt/wt rm *--force*)"
    ],
    "ask": [
      "Bash(sed -i*)",
      "Bash(sed --in-place*)",
      "Bash(sed * -i*)",
      "Bash(sed * --in-place*)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)",
      "Bash(find *-ok*)",
      "Bash(find *-fprint*)",
      "Bash(find *-fls*)",
      "Bash(rg *--pre*)",
      "Bash(git *--output*)",
      "Bash(git fetch *+*)",
      "Bash(docker compose *down*-v*)",
      "Bash(docker compose *down*--volumes*)",
      "Bash(node *-e*)",
      "Bash(node *--eval*)",
      "Bash(node *--print*)",
      "Bash(node .yarn/releases/*..*)",
      "Bash(node *.yarn/releases/*..*)",
      "Bash(*.claude/skills/*..*)",
      "Bash(*deploy*)"
    ]
  },
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "20000"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/file-suggestion.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: старт — регистрирует сессию и показывает активные задачи"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: запрос — обновляет lease перед новым сообщением"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: до инструмента — отмечает занятость и ищет пересечения"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-reads.sh\"",
            "timeout": 10,
            "statusMessage": "Защита секретов — блокирует чтение .env и вывод secret-переменных"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-workspace-deletion.sh\"",
            "timeout": 10,
            "statusMessage": "Защита воркспейса — блокирует удаление корня и общего каталога"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-force-push.py\"",
            "timeout": 10,
            "statusMessage": "Защита истории — блокирует force-push в любой форме, включая обёртки и составные команды"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-local-integration-tests.py\"",
            "timeout": 10,
            "statusMessage": "Integration только в CI — блокирует локальный запуск integration/e2e тестов"
          }
        ]
      },
      {
        "matcher": "CronCreate|CronList|CronDelete|ScheduleWakeup|RemoteTrigger|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-claude-crons.sh\"",
            "timeout": 10,
            "statusMessage": "Расписания — блокирует планировщики Claude Code в пользу Cron Job рантайма"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-agent-routing.py\"",
            "timeout": 10,
            "statusMessage": "Маршрутизация — запрещает root запись, live-операции и долгое исследование без child"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: после инструмента — обновляет lease и рабочее состояние"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: остановка — отмечает ожидание следующего запроса"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: завершение — закрывает lease сессии"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/review-session-on-end.py\"",
            "timeout": 5,
            "statusMessage": "Ревью сессии — при WORKSPACE_SESSION_REVIEW=1 запускает фоновый review-chat-session над завершённой сессией"
          }
        ]
      }
    ]
  }
}
